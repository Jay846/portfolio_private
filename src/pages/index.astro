---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jay Salvi · જય સાળવી">

  <!-- ░░ Hero Masthead Layout ░░ -->
  <header class="hero">
    <!-- Top Line -->
    <div class="hero-top">
      <span>जय साळवी · જય સાળવી</span>
      <span>Computer Engineer · Researcher</span>
    </div>

    <!-- Middle Grid: Name/Bio on Left, News Column on Right -->
    <div class="hero-content-grid">
      <div class="hero-left">
        <h1 class="hero-title">
          <span class="hero-title-first">Jay</span>
          <span class="hero-title-last">Salvi</span>
        </h1>

        <p class="hero-bio-text">
          Quantitative & AI researcher with specializing in low-level execution platforms, automated feature engineering and blackbox_os architecture.
        </p>
      </div>

      <!-- Right News Column -->
      <aside class="hero-news">
        <div class="news-header">Latest News & Updates</div>
        <ul class="news-list">
          <li>
            <span class="news-date">Sept 2026</span>
            <span class="news-text">Neuro-Symbolic Hypothesis Engine.</span>
          </li>
          <li>
            <span class="news-date">August 2026</span>
            <span class="news-text">Reverse Engineering Jane Street's 2026 ASIC Puzzle.</span> 
          </li>
          <li>
            <span class="news-date">July 2026</span>
            <span class="news-text">Released Blackbox-OS framework.</span>
          </li>
        </ul>
      </aside>
    </div>

    <!-- Hero Bottom Index Nav -->
    <nav class="hero-nav">
      <ul class="hero-nav-links">
        <li><a href="#about"><span class="hero-nav-num">i</span>Currently</a></li>
        <li><a href="#research"><span class="hero-nav-num">ii</span>Research</a></li>
        <li><a href="#projects"><span class="hero-nav-num">iii</span>Projects</a></li>
        <li><a href="#writing"><span class="hero-nav-num">iv</span>Writing & SOPs</a></li>
        <li><a href="#contact"><span class="hero-nav-num">v</span>Contact</a></li>
      </ul>
      <a href="#about" style="color: var(--muted); text-decoration: none;">Scroll ↓</a>
    </nav>
  </header>

  <!-- ░░ Main 2-Column Wrapper (Sidebar on Left, Content on Right) ░░ -->
  <div class="main-wrapper">

    <!-- Left Sidebar -->
    <aside class="sidebar">
      <!-- Rectangular Profile Frame -->
      <img src="/profile.png" alt="Jay Salvi Profile Photo" class="sidebar-profile-img" />

      <!-- Sidebar Masthead Name -->
      <div class="sidebar-name">
        Jay<br />
        <span style="font-style: italic; font-weight: 360; color: var(--muted);">Salvi</span>
      </div>
      <div class="sidebar-native-name">જય સાળવી</div>
      <div class="sidebar-role">Computer Engineer · Researcher</div>

      <!-- Contact & Social Links -->
      <div class="sidebar-contact-list">
        <div class="sidebar-contact-item">
          <span>📧</span>
          <a href="mailto:jaysalvi85@gmail.com" class="link-slide">jay85salvi@gmail.com</a>
        </div>
        <div class="sidebar-contact-item">
          <span>💻</span>
          <a href="https://github.com/Jay846" target="_blank" rel="noopener" class="link-slide">github.com/Jay846</a>
        </div>
        <div class="sidebar-contact-item">
          <span>𝕏</span>
          <a href="https://x.com/salvijay1" target="_blank" rel="noopener" class="link-slide">https://x.com/salvijay1</a>
        </div>
        <div class="sidebar-contact-item">
          <span>💼</span>
          <a href="www.linkedin.com/in/jay-salvi-0787aa245" target="_blank" rel="noopener" class="link-slide">www.linkedin.com/in/jay-salvi-0787aa245</a>
      </div>

      <!-- Research Focus -->
      <div style="border-top: 1px solid var(--hairline); padding-top: 24px; margin-top: 24px;">
        <p style="font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px;">Research Focus</p>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <span class="tag">AI Agent Architectures</span>
          <span class="tag">Order Flow Imbalances</span>
          <span class="tag">Time Series Modeling</span>
          <span class="tag">ASIC Reverse Eng</span>
        </div>
      </div>
    </aside>

    <!-- Right Main Content -->
    <main class="main-content">

      <!-- Section i: Currently / About -->
      <section id="about" class="section-block">
        <h2 class="section-head-title">Currently</h2>
        <p>
          Working at the intersection of formal hardware security verification and cognitive AI agent architectures. Currently engineering <strong>Blackbox OS</strong> for automated system testing.
        </p>
      </section>

      <!-- Section ii: Research -->
      <section id="research" class="section-block">
        <h2 class="section-head-title">Selected Research & Preprints</h2>

        <div class="paper">
          <div class="paper-meta">
            <span>August 2026</span>
            <span class="tag">Neuro-Symbolic AI </span>
            <span class="tag">Syntax Tree Safety Sandboxing</span>
            <span class="tag">Symbolic Regression</span>
            <span class="tag">SciPy Optimization</span>
          </div>
          <h3 class="paper-title">
            Neuro-Symbolic Hypothesis Engine: Autonomous Scientific Discovery via Hybrid Large Language Models and Symbolic Regression
          </h3>
          <p class="paper-authors">Jay Salvi</p>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            An autonomous quantitative discovery agent that extracts governing mathematical laws from raw empirical datasets.
          </p>
          <div class="paper-links">
            <a href="https://doi.org/10.5281/zenodo.21992963" target="_blank" rel="noopener">[Paper]</a>
            <a href="https://github.com/Jay846/Neuro-Symbolic-Hypothesis-Engine" target="_blank" rel="noopener">[Code]</a>
            <span class="tag">Preprint</span>
          </div>
        </div>

        <div class="paper">
          <div class="paper-meta">
            <span>July 2026</span>
            <span class="tag">schema collapse</span>
            <span class="tag">sandboxed code execution</span>
            <span class="tag">LLM Agents at Scale</span>
            <span class="tag">phase transition</span>
          </div>
          <h3 class="paper-title">
            From Tool Selection to Autonomous Execution: Process Templates, Sandboxed Code, and Modular Orchestration for Reliable LLM Agents at Scale
          </h3>
          <p class="paper-authors">Jay Salvi</p>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            Automated SystemVerilog Assertion (SVA) generation and bounded model checking for fault-injection hardness on lowRISC Ibex CPU cores without human-authored testbenches.
          </p>
          <div class="paper-links">
            <a href="https://doi.org/10.5281/zenodo.21869451" target="_blank" rel="noopener">[Paper]</a>
            <a href="https://github.com/Jay846/Blackbox-OS" target="_blank" rel="noopener">[Code]</a>
            <span class="tag">Preprint</span>
            
          </div>
        </div>

        <div class="paper">
          <div class="paper-meta">
            <span>June 2025</span>
            <span class="tag">Hidden Markov Modeling</span>
            <span class="tag">Order Flow Imbalances</span>
            <span class="tag">Market Microstructure</span>
          </div>
          <h3 class="paper-title">
            Asymmetric Hidden Markov Modeling of Order Flow Imbalances for Microstructure-Aware Market Regime Detection
          </h3>
          <p class="paper-authors">Jay Salvi</p>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            An empirical evaluation of structured memory design and multi-agent problem solving on the ARC-AGI benchmark. Introduces an 8-stage causal analysis pipeline with active state-space exploration.
          </p>
          <div class="paper-links">
            <a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5315733" target="_blank" rel="noopener">[Paper]</a>
            <span class="tag">Preprint</span>
          </div>
        </div>

      </section>

      <!-- Section iii: Projects & Open Source -->
      <section id="projects" class="section-block">
        <h2 class="section-head-title">Projects & Open Source</h2>

        <!-- Project 1: Blackbox-OS -->
        <div class="paper">
          <div class="paper-meta">
            <span class="tag">Python</span>
            <span class="tag">LangGraph</span>
            <span class="tag">LLM Orchestration</span>
          </div>
          <h3 class="paper-title">
            <a href="https://github.com/Jay846/Blackbox-OS" target="_blank" rel="noopener">Blackbox-OS</a>
          </h3>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            A reliable, sandboxed execution runtime and modular orchestrator for LLM agents at scale with 8-stage causal analysis and AST loopback verification.
          </p>
          <div class="paper-links">
            <a href="https://github.com/Jay846/Blackbox-OS" target="_blank" rel="noopener">GitHub Repo</a>
          </div>
        </div>

        <!-- Project 2: Neuro-Symbolic-Hypothesis-Engine -->
        <div class="paper">
          <div class="paper-meta">
            <span class="tag">Python</span>
            <span class="tag">Neuro-Symbolic</span>
            <span class="tag">Causal Reasoning</span>
          </div>
          <h3 class="paper-title">
            <a href="https://github.com/Jay846/Neuro-Symbolic-Hypothesis-Engine" target="_blank" rel="noopener">Neuro-Symbolic-Hypothesis-Engine</a>
          </h3>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            A neuro-symbolic synthesis engine combining frame-aware memory, causal world modeling, and hypothesis search for program synthesis on ARC-AGI tasks.
          </p>
          <div class="paper-links">
            <a href="https://github.com/Jay846/Neuro-Symbolic-Hypothesis-Engine" target="_blank" rel="noopener">GitHub Repo</a>
          </div>
        </div>

        <!-- Project 3: asic-puzzle-2026-solution -->
        <div class="paper">
          <div class="paper-meta">
            <span class="tag">Python</span>
            <span class="tag">GDSII / ASIC</span>
            <span class="tag">SystemVerilog</span>
          </div>
          <h3 class="paper-title">
            <a href="https://github.com/Jay846/asic-puzzle-2026-solution" target="_blank" rel="noopener">asic-puzzle-2026-solution</a>
          </h3>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            End-to-end automated reverse-engineering flow extracting gate-level netlists from raw GDSII silicon layout geometry to solve the Jane Street ASIC challenge.
          </p>
          <div class="paper-links">
            <a href="https://github.com/Jay846/asic-puzzle-2026-solution" target="_blank" rel="noopener">GitHub Repo</a> • 
            <a href="/writing/jane_street_asic_solution_writeup">[Technical Writeup]</a>
          </div>
        </div>

        <!-- Open Source Contributions Subsection -->
        <div style="margin-top: 36px; padding-top: 24px; border-top: 1px dashed var(--hairline);">
          <h3 style="font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 16px;">
            Open Source Upstream Contributions
          </h3>

          <!-- Contribution 1: NVIDIA CCCL -->
          <div class="paper">
            <div class="paper-meta">
              <span class="tag">CUDA C++</span>
              <span class="tag">NVIDIA / CCCL</span>
            </div>
            <h3 class="paper-title">
              <a href="https://github.com/NVIDIA/cccl" target="_blank" rel="noopener">NVIDIA CCCL (CUDA C++ Core Libraries)</a>
            </h3>
            <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
              Upstream CUDA parallel primitives and performance optimizations for GPU-accelerated C++ core algorithms.
            </p>
            <div class="paper-links">
              <a href="https://github.com/NVIDIA/cccl/pull/10847" target="_blank" rel="noopener">Merged PR</a>
            </div>
          </div>

          <!-- Contribution 2: Meta Velox -->
          <div class="paper">
            <div class="paper-meta">
              <span class="tag">C++20</span>
              <span class="tag">Meta / Velox</span>
            </div>
            <h3 class="paper-title">
              <a href="https://github.com/facebookincubator/velox" target="_blank" rel="noopener">Meta Velox Execution Engine</a>
            </h3>
            <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
              Hardware-aligned skew-resilient radix partitioner hook for high-throughput batch execution in Meta Velox.
            </p>
            <div class="paper-links">
              <span class="tag">Under Review</span>
            </div>
          </div>

      </section>

      <!-- Section iv: Writing & SOPs -->
      <section id="writing" class="section-block">
        <h2 class="section-head-title">Writings & Technical SOPs</h2>

        <div class="paper">
          <div class="paper-meta">
            <span>Sept 18, 2026 · 7 min read</span>
            <span class="tag">Columnar Engine</span>
            <span class="tag">Apache Arrow</span>
            <span class="tag">C++ Kernel Opt</span>
          </div>
          <h3 class="paper-title">
            <a href="/writing/cast_list_view_kernel_architecture">High-Performance Zero-Copy Casting Kernels for Apache Arrow ListView Arrays</a>
          </h3>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            A deep-dive technical article detailing zero-allocation memory slicing, O(1) contiguous pointer paths, and 64-bit word bitmap scanning for Arrow compute expressions.
          </p>
          <div class="paper-links">
            <a href="/writing/cast_list_view_kernel_architecture">[Read Writeup]</a>
            <a href="https://github.com/jay846/arrow" target="_blank" rel="noopener">[Apache Arrow Engine]</a>
          </div>
        </div>

        <div class="paper">
          <div class="paper-meta">
            <span>Sept 14, 2026 · 8 min read</span>
            <span class="tag">ASIC Reverse Engineering</span>
            <span class="tag">Z3 SMT Solving</span>
          </div>
          <h3 class="paper-title">
            <a href="/writing/jane_street_asic_solution_writeup">Reverse Engineering Jane Street's 2026 ASIC Puzzle: From GDSII Geometries to Symbolic Z3 Solving</a>
          </h3>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 12px;">
            A complete technical writeup detailing polygon extraction, footprint classification, diode bridge node recovery, and symbolic Z3 constraint modeling.
          </p>
          <div class="paper-links">
            <a href="/writing/jane_street_asic_solution_writeup">[Read Writeup]</a>
          </div>
        </div>

      </section>

      <!-- Section v: Contact -->
      <section id="contact" class="section-block">
        <h2 class="section-head-title">Contact</h2>
        <p>
          Open to research collaborations, formal security audits, and high-assurance systems engineering discussions.
        </p>
        <div class="paper-links" style="font-size: 15px;">
          <a href="mailto:jaysalvi11@gmail.com">jay85salvi@gmail.com</a> • 
          <a href="https://github.com/Jay846" target="_blank" rel="noopener">GitHub (@Jay846)</a>
        </div>
      </section>

    </main>
  </div>

</Layout>
